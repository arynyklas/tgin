      },
      "type": "array"
    },
    "consumers": {
      "additionalProperties": false,
      "default": {},
      "description": "Where updates go, by name.",
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]{0,62}$": {
          "$ref": "#/$defs/Consumer"
        }
      },
      "type": "object"
    },
    "log": {
      "$ref": "#/$defs/Log",
      "default": {
        "format": "text",
        "level": "info"
      }
    },
    "reload": {
      "$ref": "#/$defs/Reload",
      "default": {
        "debounce": "500ms",
        "drain_timeout": "30s",
        "watch": true
      }
    },
    "runtime": {
      "$ref": "#/$defs/Runtime",
      "default": {
        "lame_duck": "5s",
        "shutdown_grace": "15s",
        "worker_threads": "auto"
      }
    },
    "server": {
      "anyOf": [
        {
          "$ref": "#/$defs/Server"
        },
        {
          "type": "null"
        }
      ],
      "description": "The data plane: webhook ingress and pull consumers. Omitted, tgin\nserves neither."
    },
    "version": {
      "const": 1,
      "description": "The config format version; must be 1.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version"
  ],
  "title": "tgin configuration, version 1",
  "type": "object"
}
