(
    dark_threads: 6,
    server_port: Some(3000),

    api: Some(ApiConfig(base_path: "/api")),
    // Required whenever `api` is set; clients send `Authorization: Bearer <token>`.
    auth_token: Some("${TGIN_AUTH_TOKEN}"),

    // ssl: Some(SslConfig(cert: "/cert.pem", key: "/privkey.pem")),

    updates: [
        LongPollUpdate(
            token: "${TOKEN}",
        ),
        // WebhookUpdate(
        //     path: "/bot/pull",
        // ),
    ],

    route: RoundRobinLB(
        routes: [
            // `max_buffered_updates` defaults to 10_000. The per-route buffer
            // evicts oldest-first when full and surfaces depth + dropped counts
            // on `GET /api/routes`. tgin has already confirmed buffered updates
            // to Telegram, so evicted ones are lost; raise the cap if a
            // downstream may stay offline longer than the buffer covers.
            LongPollRoute(path: "/bot1/getUpdates", max_buffered_updates: 10000),
        ],
    ),
)
