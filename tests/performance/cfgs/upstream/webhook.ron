// ENGINE=upstream, scenario webhook-tgin-3; the makefile adds the third
// downstream through the management API.
(
    dark_threads: 6,

    api : Some(ApiConfig(base_path: "/api")),

    server_port: Some(3000),

    updates: [
        WebhookUpdate(path: "/webhook")
    ],

    route: RoundRobinLB(
        routes: [
            WebhookRoute(url: "http://10.5.0.11:8080/webhook"),
            WebhookRoute(url: "http://10.5.0.12:8080/webhook"),
        ]
    )
)
